---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — Visible Marketing" description="Page not found.">
  <section class="hero" id="main" style="text-align:center">
    <div class="wrap">
      <p class="kicker" style="justify-content:center">not visible</p>
      <h1 style="max-width:none; font-size:clamp(2.6rem,9vw,5rem)">404</h1>
      <p class="lede" style="margin-inline:auto">This page is a little too invisible. Let's get you back to something you can see.</p>
      <div class="cta-row" style="justify-content:center">
        <a class="btn btn-primary" href="/">Back to home</a>
      </div>
    </div>
  </section>
</Layout>
